---
// https://airensoft.gitbook.io/ovenplayer
// https://github.com/AirenSoft/OvenPlayer
// https://github.com/video-dev/hls.js

const { class: className, ...rest } = Astro.props
---

<div id="player-container" class:list={["relative", className]} {...rest}>
  <div id="player"></div>
  <h1 id="offline" class="hidden absolute top-1/2 left-1/2 -translate-1/2 text-center text-2xl font-bold">Offline</h1>
</div>

<style is:global>
  * {
    color: var(--color-primary);
    font-family: var(--font-sans);
    text-shadow: none !important;
  }

  #player-container {
    --op-accent-color: var(--color-accent) !important;
  }

  #player {
    background: var(--color-base-300) !important;
  }

  .op-left-controls,
  .op-right-controls {
    padding: 10px 0 10px 0 !important;
  }

  .op-gradient-bottom {
    background: var(--color-base-300) !important;
  }

  .op-setting-panel {
    background: var(--color-base-100) !important;
  }

  .op-message-box,
  .op-progressbar-container,
  .op-spinner,
  .op-setting-item[op-panel-type="speed"] {
    display: none !important;
  }
</style>

<script>
  import Hls from "hls.js"
  import OvenPlayer, { type OvenPlayerInstance } from "ovenplayer"

  declare global {
    interface Window {
      Hls: object
    }
  }

  // Force retry after timeout
  const retry = (player: OvenPlayerInstance): NodeJS.Timeout =>
    setTimeout(() => {
      player.stop()
      player.play()
    }, timeout)

  // Toggle element visibility
  const hide = (element: Element) => element.classList.add("hidden")
  const show = (element: Element) => element.classList.remove("hidden")

  window.Hls = Hls // Serve from embedded module instead of CDN
  const searchParams = new URLSearchParams(document.location.search)
  const id = searchParams.get("id") ?? "stream" // Gather target stream from URL
  const timeout = 5 * 1000 // Milliseconds

  // Gather signed policy URLs
  const urls = await fetch(`/stream/api/${id}.json`).then((response) => response.json())

  const player = OvenPlayer.create("player", {
    autoFallback: false, // Client fallback can trigger before ABR has a chance to take effect
    autoStart: false, // Assume browser requires click to start playback
    disableSeekUI: true, // Always realtime
    playbackRates: [1], // Disable playback rate options, element hidden in styles
    showBigPlayButton: true,
    webrtcConfig: { connectionTimeout: timeout },
    hlsConfig: { testBandwidth: false }, // BUG: https://github.com/OvenMediaLabs/OvenPlayer/issues/419
    sources: [
      // Prefer WebRTC over LLHLS
      {
        label: "WebRTC",
        type: "webrtc",
        file: urls.webrtc_url,
      },
      {
        label: "LLHLS",
        type: "llhls",
        file: urls.llhls_url,
      },
    ],
  })

  // Wait for player API to be ready
  player.on("ready", () => {
    const offline = document.querySelector("#offline")

    if (offline) {
      let timer: NodeJS.Timeout

      // Handle player state changes
      player.on("stateChanged", (event) => {
        switch (event.newstate) {
          // Stream offline or otherwise unreachable
          case "error":
            show(offline)
            timer = retry(player)
            break
          // Player initializing, can hang indefinitely if stream is offline
          case "loading":
            timer = retry(player)
            break
          // Internal player timeout triggered, doesn't handle every case
          case "stalled":
            timer = retry(player)
            break
          // Player successfully connected to stream
          case "playing":
            clearTimeout(timer) // Ensure retry timer is cleared to avoid interruption
            hide(offline)
            break
        }
      })
    }

    // Toggle play/pause on video element click
    player.on("clicked", (event) => {
      if (event.target == player.getMediaElement()) {
        if (player.getState() !== "playing") {
          player.play()
          player.seek(0) // Ensure realtime on play
        } else {
          player.pause()
        }
      }
    })

    // Resize player to active stream aspect ratio
    // https://github.com/OvenMediaLabs/OvenPlayer/blob/6ea7c520531362cdd06a814ce7c9d81e63fab7e9/src/js/view/view.js#L396
    player.on("qualityLevelChanged", (event) => {
      const quality = player.getQualityLevels()[event.currentQuality]
      const ratio = (quality.height / quality.width) * 100 // %
      const element = document.querySelector<HTMLElement>(".op-ratio")
      if (element) element.style.setProperty("padding-bottom", `${ratio}%`)
      player.play() // Player is paused when quality is changed
    })
  })
</script>
