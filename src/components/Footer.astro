  <p class="inline">
    Made by <a class="link link-hover" href="https://git.bjork.tech/myned?tab=activity">@myned</a>, built with <a
      class="link link-hover"
      href="https://astro.build">
      {Astro.generator}
    </a>
  </p>
  <slot />
</footer>
